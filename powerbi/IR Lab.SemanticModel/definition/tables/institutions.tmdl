table institutions
	lineageTag: 1efcbdbb-236b-4553-8b46-2c00a00d07ea

	/// Active institutions in the current filter context; one row per UNITID.
	measure Institutions = COUNTROWS ( institutions )
		formatString: #,0
		lineageTag: 1736fb8d-8091-4d37-8eda-cb30fc80f5a0

	measure 'Completion Institutions' = COUNTROWS ( FILTER ( institutions, institutions[level] = "4-year" && NOT ISBLANK ( institutions[grad_rate_bach_6yr] ) ) )
		formatString: #,0
		lineageTag: 240f8220-0ea5-4c1b-ac92-26ee4543ec30

	/// Unweighted mean of institution rates, stored on a 0–100 scale. Not a student-level graduation rate.
	measure 'Mean Completion' = AVERAGEX ( FILTER ( institutions, institutions[level] = "4-year" && NOT ISBLANK ( institutions[grad_rate_bach_6yr] ) ), institutions[grad_rate_bach_6yr] )
		formatString: 0.0"%"
		lineageTag: cb45c4a2-d50f-43d1-a4a7-e6dc58505fc1

	measure 'Median Completion' = MEDIANX ( FILTER ( institutions, institutions[level] = "4-year" && NOT ISBLANK ( institutions[grad_rate_bach_6yr] ) ), institutions[grad_rate_bach_6yr] )
		formatString: 0.0"%"
		lineageTag: 9e9353f0-ac2f-4fd3-9548-bc8a80f4ee51

	measure 'Completion SD' =
			VAR t = FILTER ( institutions, institutions[level] = "4-year" && NOT ISBLANK ( institutions[grad_rate_bach_6yr] ) )
			RETURN IF ( COUNTROWS ( t ) > 1, STDEVX.S ( t, institutions[grad_rate_bach_6yr] ) )
		formatString: 0.0" pp"
		lineageTag: 2db4616d-1727-44ed-99c3-ab07392adb66

	measure 'Completion Missing' = COUNTROWS ( FILTER ( institutions, institutions[level] = "4-year" && ISBLANK ( institutions[grad_rate_bach_6yr] ) ) )
		formatString: #,0
		lineageTag: c04b9b40-dd3f-4a61-ad38-35e9ad7b1050

	/// Lesson definition: mean cubed standardized deviation using sample SD; differs from Excel adjusted SKEW.
	measure 'Completion Skewness' =
			VAR t = FILTER ( institutions, institutions[level] = "4-year" && NOT ISBLANK ( institutions[grad_rate_bach_6yr] ) )
			VAR n = COUNTROWS ( t )
			VAR m = AVERAGEX ( t, institutions[grad_rate_bach_6yr] )
			VAR s = IF ( n > 1, STDEVX.S ( t, institutions[grad_rate_bach_6yr] ) )
			RETURN IF ( n > 2 && s > 0, AVERAGEX ( t, POWER ( DIVIDE ( institutions[grad_rate_bach_6yr] - m, s ), 3 ) ) )
		formatString: 0.000
		lineageTag: f14fcdee-4435-4a30-a89a-6aa25a562b6b

	/// 2022–23; median of institution-level average net prices; in-state at public institutions.
	measure 'Median Net Price' = MEDIAN ( institutions[net_price] )
		formatString: $#,0
		lineageTag: 324a5687-20c3-4767-aa62-c2a1cfb8cc1f

	measure 'Regression Institutions' = COUNTROWS ( FILTER ( institutions, institutions[level] = "4-year" && institutions[bach_cohort] >= 30 && NOT ISBLANK ( institutions[pct_pell] ) && NOT ISBLANK ( institutions[grad_rate_bach_6yr] ) ) )
		formatString: #,0
		lineageTag: 33a27587-1c77-4350-b3f1-678f85bc7e88

	/// Unweighted OLS; four-year institutions, bachelor cohort >=30, complete Pell and completion. Refit within current filters.
	measure 'Pell Slope' =
			VAR t = FILTER ( institutions, institutions[level] = "4-year" && institutions[bach_cohort] >= 30 && NOT ISBLANK ( institutions[pct_pell] ) && NOT ISBLANK ( institutions[grad_rate_bach_6yr] ) )
			VAR n = COUNTROWS ( t )
			VAR sx = IF ( n > 1, STDEVX.S ( t, institutions[pct_pell] ) )
			RETURN IF ( n > 2 && sx > 0, MAXX ( LINESTX ( t, institutions[grad_rate_bach_6yr], institutions[pct_pell] ), [Slope1] ) )
		formatString: 0.000" pp/pp"
		lineageTag: ff4a949e-6252-48ae-8625-efaeae77be83

	/// Unweighted OLS; four-year institutions, bachelor cohort >=30, complete Pell and completion. Refit within current filters.
	measure 'Pell Intercept' =
			VAR t = FILTER ( institutions, institutions[level] = "4-year" && institutions[bach_cohort] >= 30 && NOT ISBLANK ( institutions[pct_pell] ) && NOT ISBLANK ( institutions[grad_rate_bach_6yr] ) )
			VAR n = COUNTROWS ( t )
			VAR sx = IF ( n > 1, STDEVX.S ( t, institutions[pct_pell] ) )
			RETURN IF ( n > 2 && sx > 0, MAXX ( LINESTX ( t, institutions[grad_rate_bach_6yr], institutions[pct_pell] ), [Intercept] ) )
		formatString: 0.00" pp"
		lineageTag: ef82469f-5ff3-43a5-ad16-12ec947d3431

	/// Unweighted OLS; four-year institutions, bachelor cohort >=30, complete Pell and completion. Refit within current filters.
	measure 'Pell R Squared' =
			VAR t = FILTER ( institutions, institutions[level] = "4-year" && institutions[bach_cohort] >= 30 && NOT ISBLANK ( institutions[pct_pell] ) && NOT ISBLANK ( institutions[grad_rate_bach_6yr] ) )
			VAR n = COUNTROWS ( t )
			VAR sx = IF ( n > 1, STDEVX.S ( t, institutions[pct_pell] ) )
			RETURN IF ( n > 2 && sx > 0, MAXX ( LINESTX ( t, institutions[grad_rate_bach_6yr], institutions[pct_pell] ), [CoefficientOfDetermination] ) )
		formatString: 0.000
		lineageTag: 44a06c1c-b098-41b6-8aab-0db08cfc1694

	/// Unweighted OLS; four-year institutions, bachelor cohort >=30, complete Pell and completion. Refit within current filters.
	measure 'Residual SE' =
			VAR t = FILTER ( institutions, institutions[level] = "4-year" && institutions[bach_cohort] >= 30 && NOT ISBLANK ( institutions[pct_pell] ) && NOT ISBLANK ( institutions[grad_rate_bach_6yr] ) )
			VAR n = COUNTROWS ( t )
			VAR sx = IF ( n > 1, STDEVX.S ( t, institutions[pct_pell] ) )
			RETURN IF ( n > 2 && sx > 0, MAXX ( LINESTX ( t, institutions[grad_rate_bach_6yr], institutions[pct_pell] ), [StandardError] ) )
		formatString: 0.00" pp"
		lineageTag: aea247ad-0299-42e6-b1da-df049b5450e1

